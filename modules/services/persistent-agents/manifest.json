{
  "schemaVersion": 2,
  "id": "persistent-agents",
  "name": "Persistent agents",
  "kind": "service",
  "entry": "src/index.ts",
  "moduleApiVersion": 1,
  "dependencies": [
    "workspace",
    "persistence",
    "agent-runner",
    "internal-local-mcp",
    "internal-remote-mcp",
    "git-tasks",
    "mcp-auth"
  ],
  "capabilities": [
    "remote.daemon",
    "ssh.connect",
    "fs.scope",
    "approvals.request"
  ],
  "provides": [
    "agents.persistent"
  ],
  "runsOn": "ui",
  "stateVersion": 1,
  "description": "Desktop gateway for independent background agents owned by local and SSH daemons.",
  "author": "Hato contributors",
  "version": "0.1.7",
  "pluginPackage": "agents",
  "pluginType": "Automation"
}
