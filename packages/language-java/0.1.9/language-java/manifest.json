{
  "schemaVersion": 2,
  "id": "language-java",
  "name": "Java",
  "kind": "service",
  "entry": "src/index.ts",
  "moduleApiVersion": 1,
  "dependencies": [
    "persistence"
  ],
  "capabilities": [],
  "provides": [
    "language.provider"
  ],
  "runsOn": "ui",
  "contributes": {
    "languages": [
      {
        "id": "java",
        "name": "Java",
        "extensions": [
          "java"
        ],
        "grammar": "java",
        "highlightQuery": [
          "; Java highlights for Hato. gpui-component keeps the first capture reported for a token (matches",
          "; arrive by start position, then pattern order), so the generic identifier fallback comes last.",
          "[(line_comment) (block_comment)] @comment",
          "[(character_literal) (string_literal)] @string",
          "(escape_sequence) @string.escape",
          "[(hex_integer_literal) (decimal_integer_literal) (octal_integer_literal) (binary_integer_literal)",
          " (decimal_floating_point_literal) (hex_floating_point_literal)] @number",
          "[(true) (false) (null_literal)] @constant.builtin",
          "(this) @variable.builtin",
          "(super) @function.builtin",
          "",
          "(annotation \"@\" @attribute name: (_) @attribute)",
          "(marker_annotation \"@\" @attribute name: (_) @attribute)",
          "",
          "[(boolean_type) (integral_type) (floating_point_type) (void_type)] @type.builtin",
          "(type_identifier) @type",
          "(interface_declaration name: (identifier) @type)",
          "(class_declaration name: (identifier) @type)",
          "(enum_declaration name: (identifier) @type)",
          "(record_declaration name: (identifier) @type)",
          "(annotation_type_declaration name: (identifier) @type)",
          "(constructor_declaration name: (identifier) @constructor)",
          "((field_access object: (identifier) @type) (#match? @type \"^[A-Z]\"))",
          "((scoped_identifier scope: (identifier) @type) (#match? @type \"^[A-Z]\"))",
          "((method_invocation object: (identifier) @type) (#match? @type \"^[A-Z]\"))",
          "((method_reference . (identifier) @type) (#match? @type \"^[A-Z]\"))",
          "",
          "((identifier) @constant (#match? @constant \"^_*[A-Z][A-Z0-9_]+$\"))",
          "(enum_constant name: (identifier) @constant)",
          "",
          "(method_declaration name: (identifier) @function.method)",
          "(method_invocation name: (identifier) @function.method)",
          "",
          "((field_declaration declarator: (variable_declarator name: (identifier) @property)) (#not-match? @property \"^_*[A-Z][A-Z0-9_]+$\"))",
          "((field_access field: (identifier) @property) (#not-match? @property \"^_*[A-Z][A-Z0-9_]+$\"))",
          "",
          "[\"abstract\" \"assert\" \"break\" \"case\" \"catch\" \"class\" \"continue\" \"default\" \"do\" \"else\" \"enum\"",
          " \"exports\" \"extends\" \"final\" \"finally\" \"for\" \"if\" \"implements\" \"import\" \"instanceof\" \"interface\"",
          " \"module\" \"native\" \"new\" \"non-sealed\" \"open\" \"opens\" \"package\" \"permits\" \"private\" \"protected\"",
          " \"provides\" \"public\" \"requires\" \"record\" \"return\" \"sealed\" \"static\" \"strictfp\" \"switch\"",
          " \"synchronized\" \"throw\" \"throws\" \"to\" \"transient\" \"transitive\" \"try\" \"uses\" \"volatile\" \"when\"",
          " \"while\" \"with\" \"yield\"] @keyword",
          "",
          "[\"(\" \")\" \"[\" \"]\" \"{\" \"}\"] @punctuation.bracket",
          "[\".\" \",\" \";\" \":\" \"::\"] @punctuation.delimiter",
          "[\"->\" \"=\" \"==\" \"!=\" \"<\" \">\" \"<=\" \">=\" \"&&\" \"||\" \"!\" \"+\" \"-\" \"*\" \"/\" \"%\" \"++\" \"--\" \"?\" \"&\" \"|\" \"^\" \"~\"",
          " \"+=\" \"-=\" \"*=\" \"/=\" \"<<\" \">>\" \">>>\"] @operator",
          "",
          "(identifier) @variable"
        ],
        "server": {
          "id": "jdtls",
          "executable": "jdtls",
          "args": [
            "-data",
            "$SERVER_DATA"
          ],
          "settings": {
            "java": {
              "configuration": {
                "updateBuildConfiguration": "automatic"
              }
            }
          },
          "installHint": "Install Eclipse JDTLS and a supported JDK on the workspace machine; put jdtls on PATH or set its full path here.",
          "dependencySetup": {
            "kind": "jdtls",
            "version": "1.63.0",
            "url": "https://download.eclipse.org/jdtls/milestones/1.63.0/jdt-language-server-1.63.0-202610191322.tar.gz",
            "sha256": "b1f2abe0b3cccb462cf64fb4a5587c7d09df60cf8be7748b152cbd89d018bdc4",
            "javaMajor": 25
          },
          "projectSettings": {
            "title": "Java project",
            "enabledLabel": "Treat this workspace as a Java project",
            "initializationSettings": true,
            "fields": [
              {
                "key": "sourcePaths",
                "label": "Source folders",
                "setting": "java.project.sourcePaths",
                "type": "paths",
                "description": "Workspace-relative folders, one per line. Leave empty for automatic detection. Plain Java projects only; Maven/Gradle use their build files.",
                "directory": true
              },
              {
                "key": "outputPath",
                "label": "Output folder",
                "setting": "java.project.outputPath",
                "type": "text",
                "description": "Workspace-relative output folder for plain Java projects. Leave empty for the server default.",
                "directory": true
              },
              {
                "key": "referencedLibraries",
                "label": "Referenced libraries",
                "setting": "java.project.referencedLibraries",
                "type": "paths",
                "description": "Workspace-relative JAR paths or globs, one per line (for example lib/**/*.jar)."
              },
              {
                "key": "maven",
                "label": "Import Maven projects",
                "setting": "java.import.maven.enabled",
                "type": "toggle"
              },
              {
                "key": "mavenSettings",
                "label": "Maven settings file",
                "setting": "java.configuration.maven.userSettings",
                "type": "text",
                "absolute": true,
                "description": "Workspace-relative settings.xml for repositories, mirrors and credentials (for example .mvn/settings.xml when the build runs mvn -s). Leave empty for ~/.m2/settings.xml."
              },
              {
                "key": "gradle",
                "label": "Import Gradle projects",
                "setting": "java.import.gradle.enabled",
                "type": "toggle"
              }
            ]
          },
          "buildFiles": [
            "pom.xml",
            "build.gradle",
            "build.gradle.kts",
            "settings.gradle",
            "settings.gradle.kts"
          ]
        }
      }
    ],
    "filePresentation": {
      "rules": []
    }
  },
  "stateVersion": 1,
  "description": "Java syntax highlighting and go to definition through Eclipse JDTLS, locally or over SSH.",
  "author": "Hato contributors",
  "version": "0.1.9",
  "pluginPackage": "language-java",
  "pluginType": "Languages",
  "distribution": "marketplace",
  "calls": [
    "persistence"
  ]
}
