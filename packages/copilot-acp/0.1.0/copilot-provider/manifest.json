{
  "schemaVersion": 2,
  "id": "copilot-provider",
  "name": "GitHub Copilot provider",
  "kind": "service",
  "entry": "src/index.ts",
  "moduleApiVersion": 1,
  "dependencies": [],
  "calls": [],
  "capabilities": [],
  "provides": [
    "ai.provider"
  ],
  "distribution": "marketplace",
  "contributes": {
    "agentProviders": [
      {
        "id": "copilot",
        "name": "GitHub Copilot",
        "profile": {
          "id": "copilot",
          "name": "GitHub Copilot (ACP)",
          "executable": "copilot",
          "args": [
            "--acp",
            "--stdio"
          ]
        },
        "adapter": {
          "pkg": "@github/copilot",
          "bin": "copilot"
        }
      }
    ]
  },
  "version": "0.1.0",
  "pluginPackage": "copilot-acp",
  "pluginType": "AI providers",
  "description": "GitHub Copilot CLI over native ACP stdio, with workspace-scoped launch and explicit CLI installation."
}
